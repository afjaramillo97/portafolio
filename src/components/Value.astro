---
import type { Content } from '../i18n/types';
import SectionHeader from './SectionHeader.astro';
interface Props {
  c: Content;
}
const { c } = Astro.props;
const v = c.value;
---

<section id={c.ids.value} class="section" aria-labelledby={`${c.ids.value}-title`}>
  <div class="container-page">
    <SectionHeader id={c.ids.value} kicker={v.kicker} title={v.title} lead={v.lead} />
    <ul class="grid gap-4 md:grid-cols-2 md:gap-6">
      {
        v.cards.map((card, i) => (
          <li class="card value-card flex flex-col p-6 md:p-8" data-reveal style={`--i:${i % 2}`}>
            <h3 class="text-[20px] font-semibold leading-snug">{card.title}</h3>
            <p class="mt-3 text-muted">{card.text}</p>
            <div class="proof mt-6">
              <p class="t-mono text-accent">{v.proofLabel}</p>
              <p class="mt-1">{card.proof}</p>
            </div>
            <ul class="mt-6 flex flex-wrap gap-2 pt-1 md:mt-auto">
              {card.chips.map((chip) => (
                <li class="chip">{chip}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .value-card {
    transition: border-color 0.15s var(--ease-ui), transform 0.15s var(--ease-ui);
  }
  .value-card:hover {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
  }
  .proof {
    padding-left: 14px;
    border-left: 2px solid var(--accent);
    margin-bottom: 24px;
  }
</style>
