---
interface Props {
  kicker: string;
  title: string;
  lead?: string;
  id: string;
}
const { kicker, title, lead, id } = Astro.props;
---

<div class="mb-12 md:mb-16" data-reveal>
  <p class="kicker mb-3">{kicker}</p>
  <h2 id={`${id}-title`} class="t-title">{title}</h2>
  {lead && <p class="t-lead measure mt-4 text-muted">{lead}</p>}
</div>
