---
import type { Content } from '../i18n/types';
import { iconSvg } from '../lib/icons';
interface Props {
  c: Content;
}
const { c } = Astro.props;
const a = c.about;
const k = c.contact;
---

<section class="section pt-0 md:pt-0" aria-labelledby="about-title">
  <div class="container-page grid grid-cols-1 gap-10 md:grid-cols-[2fr_3fr] md:gap-16">
    <div data-reveal>
      <p class="kicker">{a.kicker}</p>
      <h2 id="about-title" class="t-title mt-3">{a.title}</h2>
    </div>
    <div data-reveal style="--i:1">
      {a.paragraphs.map((p) => <p class="t-lead measure mb-4">{p}</p>)}
      <ul class="mt-6 flex flex-wrap gap-2">
        {a.soft.map((s) => <li class="chip">{s}</li>)}
      </ul>
    </div>
  </div>
</section>

<section id={c.ids.contact} class="section border-t border-line" aria-labelledby={`${c.ids.contact}-title`}>
  <div class="container-page text-center">
    <p class="kicker" data-reveal>{k.kicker}</p>
    <h2 id={`${c.ids.contact}-title`} class="t-display mt-3" data-reveal style="--i:1">{k.title}</h2>
    <p class="t-lead mx-auto mt-4 max-w-[34ch] text-muted" data-reveal style="--i:2">{k.text}</p>

    <div class="mt-10 flex flex-col items-center gap-4" data-reveal style="--i:3">
      <div class="email-row">
        <a href={`mailto:${k.email}`} class="email t-lead">{k.email}</a>
        <button type="button" class="btn copy" data-copy={k.email} data-copied={k.copied}>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="8" y="8" width="12" height="12" rx="2.5"></rect>
            <path d="M16 8V6.5A2.5 2.5 0 0 0 13.5 4h-7A2.5 2.5 0 0 0 4 6.5v7A2.5 2.5 0 0 0 6.5 16H8"></path>
          </svg>
          <span data-copy-label>{k.copy}</span>
        </button>
        <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
      </div>

      <div class="mt-2 flex flex-wrap justify-center gap-3">
        <a href={c.links.linkedin} class="btn" target="_blank" rel="me noopener">LinkedIn ↗</a>
        <a href={c.links.github} class="btn" target="_blank" rel="me noopener">
          <Fragment set:html={iconSvg('github', 16)} />GitHub ↗
        </a>
        <a href={c.hero.cvHref} class="btn" download>{k.cvLabel}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .email-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }
  .email {
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
    overflow-wrap: anywhere;
  }
  .email:hover {
    color: var(--accent);
  }
  .copy:global(.is-copied) {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
