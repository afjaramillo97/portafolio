---
import type { Content } from '../i18n/types';
import SectionHeader from './SectionHeader.astro';
import { chipIcon, iconSvg } from '../lib/icons';
interface Props {
  c: Content;
}
const { c } = Astro.props;
const p = c.project;
const check = iconSvg('check', 14);
---

<section id={c.ids.project} class="section" aria-labelledby={`${c.ids.project}-title`}>
  <div class="container-page">
    <SectionHeader id={c.ids.project} kicker={p.kicker} title={p.title} lead={p.subtitle} />

    <article class="card overflow-hidden" data-reveal>
      <div class="p-5 md:p-10">
        <p class="status t-mono">
          <span class="status-dot" aria-hidden="true"></span>
          <span>{p.status}</span>
        </p>
        <p class="measure mt-5">{p.text}</p>

        <dl class="facts mt-8 grid grid-cols-2 gap-x-6 gap-y-6 border-y border-line py-6 md:grid-cols-4">
          {
            p.facts.map((f) => (
              <div class="flex flex-col-reverse gap-1">
                <dt class="text-muted">{f.label}</dt>
                <dd class="t-lead font-semibold">{f.value}</dd>
              </div>
            ))
          }
        </dl>

        <div class="mt-10 flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
          <h3 class="t-mono text-muted">{p.archTitle}</h3>
          <p class="legend t-mono text-muted" aria-hidden="true">
            <span class="legend-item"><span class="legend-key is-live"></span>{p.archLegend.live}</span>
            <span class="legend-item"><span class="legend-key is-next"></span>{p.archLegend.next}</span>
          </p>
        </div>
        <ol class="arch mt-4">
          {
            p.arch.map((step, i) => (
              <li class:list={['arch-step', step.live ? 'is-live' : 'is-next']}>
                <span class="t-mono step-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="step-name font-medium">{step.name}</span>
                <span class="t-mono text-muted">{step.detail}</span>
                <span class="sr-only">· {step.live ? p.archLegend.live : p.archLegend.next}</span>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="border-t border-line p-5 md:p-10">
        <h3 class="t-mono text-muted">{p.roadmapTitle}</h3>
        <ol class="roadmap mt-4">
          {
            p.specs.map((s) => (
              <li class:list={['spec', `is-${s.status}`]} aria-current={s.status === 'next' ? 'step' : undefined}>
                <span class="spec-bar" aria-hidden="true" />
                <span class="spec-head t-mono">
                  {s.status === 'done' && <span class="spec-check" set:html={check} />}
                  {s.n}
                </span>
                <span class="spec-title">{s.title}</span>
                {s.status === 'next' ? (
                  <span class="spec-tag t-mono">{p.specStatus.next}</span>
                ) : (
                  <span class="sr-only">· {p.specStatus[s.status]}</span>
                )}
              </li>
            ))
          }
        </ol>
        <p class="measure mt-6 text-muted">{p.roadmapNote}</p>

        <ul class="mt-8 flex flex-wrap gap-2" aria-label="Stack">
          {
            p.chips.map((chip) => (
              <li class="chip">
                {chipIcon(chip) && <span class="chip-icon" set:html={chipIcon(chip)} />}
                {chip}
              </li>
            ))
          }
        </ul>

        <div class="mt-8 flex flex-wrap gap-3">
          {
            p.repoHref ? (
              <a href={p.repoHref} class="btn btn-primary" target="_blank" rel="noopener">
                {p.repoLabel} ↗
              </a>
            ) : (
              <span class="btn" aria-disabled="true">
                {p.repoSoon}
              </span>
            )
          }
          <a href={p.specsHref} class="btn" target="_blank" rel="noopener">
            {p.specsLabel} ↗
          </a>
          <span class="btn" aria-disabled="true">{p.demoSoon}</span>
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 12px;
    border-radius: 999px;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    max-width: 100%;
  }
  .status-dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--accent);
    animation: blink 2.4s ease-in-out infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0.35;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .status-dot {
      animation: none;
    }
  }

  /* Legend: in production (solid accent) · next (dashed) */
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .legend-key {
    width: 16px;
    height: 8px;
    border-radius: 3px;
  }
  .legend-key.is-live {
    border: 1px solid var(--accent);
  }
  .legend-key.is-next {
    border: 1px dashed var(--muted);
  }

  /* Architecture: vertical on mobile, 5 + 3 steps on desktop */
  .arch {
    display: grid;
    gap: 8px;
  }
  .arch-step {
    position: relative;
    display: grid;
    align-content: start;
    gap: 2px;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg);
  }
  .arch-step.is-live {
    border-color: var(--accent);
  }
  .arch-step.is-live .step-num {
    color: var(--accent);
  }
  .arch-step.is-next {
    border: 1px dashed color-mix(in srgb, var(--muted) 60%, var(--line));
  }
  .arch-step.is-next .step-num,
  .arch-step.is-next .step-name {
    color: var(--muted);
  }
  .arch-step:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -9px;
    width: 1px;
    height: 8px;
    background: var(--line);
  }
  .arch-step.is-live:not(:last-child)::after {
    background: var(--accent);
  }
  @media (min-width: 900px) {
    .arch {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 16px;
    }
    .arch-step {
      padding: 16px;
    }
    .arch-step:not(:last-child)::after {
      left: auto;
      right: -16px;
      top: 50%;
      bottom: auto;
      width: 16px;
      height: 1px;
    }
    /* End of the first row: no connector into empty space */
    .arch-step:nth-child(5)::after {
      display: none;
    }
  }

  /* Roadmap: list on mobile, 6 × 2 grid on desktop */
  .roadmap {
    display: grid;
    gap: 16px;
  }
  .spec {
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    grid-template-areas:
      'head title'
      'head tag';
    align-items: baseline;
    align-content: start;
    column-gap: 8px;
    padding-left: 16px;
  }
  .spec-bar {
    position: absolute;
    left: 0;
    top: 4px;
    bottom: 4px;
    width: 3px;
    border-radius: 3px;
    background: var(--line);
  }
  .spec-head {
    grid-area: head;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--muted);
  }
  .spec-check {
    display: inline-grid;
    color: var(--accent);
  }
  .spec-title {
    grid-area: title;
    line-height: 1.35;
  }
  .spec-tag {
    grid-area: tag;
    margin-top: 4px;
  }
  .spec.is-done .spec-bar {
    background: var(--accent);
  }
  .spec.is-next .spec-bar {
    background: var(--signal);
  }
  .spec.is-next .spec-head,
  .spec.is-next .spec-title,
  .spec.is-next .spec-tag {
    color: var(--signal);
    font-weight: 600;
  }
  .spec.is-planned .spec-title {
    color: var(--muted);
  }
  @media (min-width: 900px) {
    .roadmap {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      column-gap: 8px;
      row-gap: 24px;
    }
    .spec {
      grid-template-columns: auto 1fr;
      grid-template-areas:
        'head tag'
        'title title';
      align-items: center;
      row-gap: 4px;
      padding-left: 0;
      padding-top: 16px;
    }
    .spec-bar {
      right: 0;
      bottom: auto;
      width: auto;
      height: 4px;
      top: 0;
    }
    .spec-tag {
      margin-top: 0;
    }
  }
</style>
