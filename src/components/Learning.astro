---
import type { Content } from '../i18n/types';
interface Props {
  c: Content;
}
const { c } = Astro.props;
const l = c.learning;
---

<section class="section pt-0 md:pt-0" aria-labelledby="learning-title">
  <div class="container-page">
    <div class="learning card p-6 md:p-10" data-reveal>
      <p class="kicker learning-kicker">{l.kicker}</p>
      <h2 id="learning-title" class="t-title mt-3">{l.title}</h2>
      <p class="mt-3 text-muted">{l.lead}</p>
      <ul class="mt-8 grid gap-4 md:grid-cols-3 md:gap-6">
        {
          l.items.map((item) => (
            <li class="item">
              <p class="font-medium">{item.topic}</p>
              <p class="mt-1 text-muted">{item.why}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .learning {
    border-color: color-mix(in srgb, var(--signal) 35%, var(--line));
  }
  .learning-kicker {
    color: var(--signal);
  }
  .item {
    padding-left: 14px;
    border-left: 2px solid color-mix(in srgb, var(--signal) 60%, transparent);
  }
</style>
