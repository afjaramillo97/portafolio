---
import '../styles/global.css';
import type { Content } from '../i18n/types';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  c: Content;
}
const { c } = Astro.props;

const site = Astro.site ?? new URL('https://example.com');
const canonical = new URL(Astro.url.pathname, site).href;
const esUrl = new URL('/', site).href;
const enUrl = new URL('/en/', site).href;
const ogImage = new URL(c.meta.ogImage, site).href;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Andrés Felipe Jaramillo Rueda',
  alternateName: 'Andrés Jaramillo',
  jobTitle: 'AI Engineer',
  url: canonical,
  image: new URL('/og-es.png', site).href,
  address: { '@type': 'PostalAddress', addressLocality: 'Medellín', addressCountry: 'CO' },
  sameAs: [c.links.github, c.links.linkedin],
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Universidad Industrial de Santander' },
    { '@type': 'CollegeOrUniversity', name: 'Universidad Internacional de La Rioja' },
  ],
  knowsAbout: ['LLM agents', 'RAG', 'LLM evaluation', 'Node.js', 'Python', 'AWS Bedrock'],
};
---

<!doctype html>
<html lang={c.htmlLang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{c.meta.title}</title>
    <meta name="description" content={c.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0F1924" />
    <meta name="author" content="Andrés Jaramillo" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Andrés Jaramillo" />
    <meta property="og:title" content={c.meta.title} />
    <meta property="og:description" content={c.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={c.meta.ogAlt} />
    <meta property="og:locale" content={c.ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={c.meta.title} />
    <meta name="twitter:description" content={c.meta.description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />

    <!-- Theme before first paint: dark by default, remembered per browser. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t === 'light' || t === 'dark') d.setAttribute('data-theme', t);
      })();
    </script>
  </head>
  <body class="min-h-svh overflow-x-clip">
    <canvas class="page-graph" data-node-graph aria-hidden="true"></canvas>
    <a class="skip-link" href="#main">{c.nav.skip}</a>
    <Nav c={c} />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer c={c} />
    <div class="lang-hint card" data-lang-hint hidden lang={c.langHint.lang} role="region" aria-label={c.langHint.text}>
      <p>{c.langHint.text}</p>
      <a href={c.nav.otherLang.href} hreflang={c.nav.otherLang.hreflang} class="btn btn-primary" data-lang-hint-go>{c.langHint.cta}</a>
      <button type="button" class="lang-hint-close" data-lang-hint-close aria-label={c.langHint.close}>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
      </button>
    </div>
    <script>
      import '../scripts/ui';
      import { mountNodeGraph } from '../scripts/node-graph';
      const canvas = document.querySelector<HTMLCanvasElement>('[data-node-graph]');
      if (canvas) {
        const start = () => mountNodeGraph(canvas);
        if (document.readyState === 'complete') start();
        else window.addEventListener('load', start, { once: true });
        // Full strength over the hero, softer behind the rest of the page.
        const hero = document.querySelector('[data-hero]');
        if (hero) {
          new IntersectionObserver(([e]) => canvas.classList.toggle('is-dim', !e.isIntersecting), {
            rootMargin: '-35% 0px 0px 0px',
          }).observe(hero);
        }
      }
    </script>
  </body>
</html>
